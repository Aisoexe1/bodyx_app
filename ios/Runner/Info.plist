<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>BodyX</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>BodyX</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSHealthShareUsageDescription</key>
	<string>BodyX reads your steps, calories, sleep, water, weight and body fat percentage from Health to keep your dashboard accurate.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>BodyX does not write any data back to Health.</string>
	<key>NSCameraUsageDescription</key>
	<string>BodyX uses your camera to take progress photos so you can visually compare your body over time.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>BodyX lets you pick an existing photo from your library to add as a progress photo.</string>
	<!-- Google Sign-In redirect (reversed iOS client ID). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.674801778590-3t4apcivrea6c82ott9lrncq5bsvhvof</string>
			</array>
		</dict>
	</array>
	<key>GIDClientID</key>
	<string>674801778590-3t4apcivrea6c82ott9lrncq5bsvhvof.apps.googleusercontent.com</string>
	<!-- No UIApplicationSceneManifest: deliberately using the classic
	     single-window (non-Scene) app lifecycle. The Scene-connection path
	     (implicit engine attaching to a storyboard-instantiated
	     FlutterViewController asynchronously during scene creation) has a
	     known Flutter engine race on ProMotion devices when launched without
	     a debugger attached — viewDidLoad can fire before the engine finishes
	     attaching, leaving platformTaskRunner null and segfaulting in
	     -[VSyncClient initWithTaskRunner:callback:] a few dozen milliseconds
	     after launch (flutter/flutter#183900, #153971) — confirmed via real
	     on-device crash reports, 100% reproducible from a Home Screen tap.
	     The classic lifecycle builds the engine + window + root view
	     controller synchronously in didFinishLaunchingWithOptions, with no
	     such race. Revisit once the upstream engine bug is fixed — Flutter's
	     own tooling warns Scene support will eventually be mandatory. -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
