MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=bodyx
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
SESSION_SECRET=change-this-to-a-different-long-random-string

# Optional — leave unset to run password-reset in dev mode (code is logged
# and echoed back in the API response instead of emailed).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=BodyX <no-reply@bodyx.app>
# SMTP_USE_TLS=true

# Optional — leave unset to keep Google/Apple sign-in returning 501 until
# real OAuth clients exist (Google Cloud Console / Apple Developer).
# GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# APPLE_CLIENT_ID=com.yourteam.bodyx.signin
